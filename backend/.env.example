# Copy to .env for local runs. `uv run python -m tools.devdb` fills DATABASE_URL, TEST_DATABASE_URL, JWT_SECRET and MASTER_KEY.
DATABASE_URL=postgresql://agentgrid:agentgrid@127.0.0.1:5432/agentgrid
JWT_SECRET=change-me-long-random
MASTER_KEY=change-me-long-random
PUBLIC_API_URL=http://localhost:8000
CONSOLE_URL=http://localhost:5173

# Platform-default LLM. Leave LLM_API_KEY empty to run on the built-in offline demo model.
# LLM_PROVIDER: openrouter | openai | anthropic | qwen | ollama | openai_compat
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_CHEAP_MODEL=openai/gpt-4o-mini

# Embeddings: fastembed (local, default) | openai (any OpenAI-compatible API, 384 dims) | none (keyword search only)
EMBEDDINGS=fastembed

# Optional: real email delivery (otherwise emails stay in the console's Outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AgentGrid <no-reply@example.com>

DEMO_PASSWORD=AgentGrid#Demo2026
